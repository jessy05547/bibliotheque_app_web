# .htaccess pour la gestion de la performance et de la sécurité
# Placer ce fichier dans le dossier `public/` de votre projet

########################################
# Sécurité générale
########################################

# Empêcher l'affichage du listing des dossiers
Options -Indexes

# Forcer encodage UTF-8
AddDefaultCharset UTF-8

# Protéger les fichiers sensibles
<FilesMatch "\.(env|ini|phps|bak|config|sql|sqlite)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Empêcher l'accès aux fichiers PHP source si accidentellement exposés
<FilesMatch "\.(php|inc)$">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
</FilesMatch>

########################################
# Headers de sécurité (ajustez selon vos besoins)
########################################
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set X-XSS-Protection "1; mode=block"
    # Permissions-Policy (anciennement Feature-Policy) - adapter selon les features utilisées
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    # Prévenir la mise en cache côté proxy pour les réponses dynamiques (optionnel)
    # Header set Cache-Control "no-store, no-cache, must-revalidate"
</IfModule>

# Strict-Transport-Security (activer seulement si HTTPS est utilisé)
<IfModule mod_setenvif.c>
    <If "%{HTTPS} == 'on'">
        <IfModule mod_headers.c>
            Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        </IfModule>
    </If>
</IfModule>

########################################
# Compression (Gzip)
########################################
<IfModule mod_deflate.c>
    # Compression pour types courants
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/javascript application/json application/xml application/rss+xml image/svg+xml
    # Ne pas compresser les assets déjà compressés
    SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|zip|gz|rar|bz2|mp4)$ no-gzip dont-vary
    Header append Vary Accept-Encoding
</IfModule>

########################################
# Expire headers / cache navigateur
########################################
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
</IfModule>

# Supprimer ETag pour éviter revalidation coûteuse
FileETag None

########################################
# CORS pour fonts (si nécessaire)
########################################
<IfModule mod_headers.c>
    <FilesMatch "\.(ttf|ttc|otf|eot|woff|woff2)$">
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>
</IfModule>

########################################
# Réécritures : passer toutes les requêtes non-fichiers à index.php
# Permet un front controller simple et des URLs propres
########################################
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /bibliotheque_app_web/public/

    # Ne pas réécrire si le fichier ou dossier existe
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Réécrire vers index.php (conserver la query string)
    RewriteRule ^ index.php [L,QSA]
</IfModule>

########################################
# Logging et performance additionnelle (optionnel)
########################################
# LimitRequestBody 10485760  # limite upload 10MB

# Fin du fichier .htaccess
